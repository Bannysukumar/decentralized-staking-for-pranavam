# Blockchain Network Configuration
NETWORK=testnet
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
BSC_MAINNET_RPC_URL=https://bsc-dataseed1.binance.org/

# Private Key for Contract Deployment (DO NOT COMMIT REAL KEYS)
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Contract Addresses - Updated after deployment
PRANA_TOKEN_ADDRESS=
STAKING_CONTRACT_ADDRESS=
EXCHANGE_CONTRACT_ADDRESS=
REFERRAL_CONTRACT_ADDRESS=

# API Keys
BSCSCAN_API_KEY=your_bscscan_api_key
INFURA_PROJECT_ID=your_infura_project_id

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SESSION_SECRET=your_session_secret_here
CORS_ORIGIN=http://localhost:3000

# AWS Amplify Deployment
AWS_REGION=us-east-1
AWS_PROFILE=default

# Development Environment
NODE_ENV=development
PORT=3000

# Task Master AI API Keys (Optional - for development tooling)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"       # Optional: Format: sk-ant-api03-...
PERPLEXITY_API_KEY="your_perplexity_api_key_here"     # Optional: Format: pplx-...
OPENAI_API_KEY="your_openai_api_key_here"             # Optional: Format: sk-proj-...