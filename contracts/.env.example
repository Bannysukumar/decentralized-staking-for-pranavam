# Private Key for Deployment (NEVER commit this to git)
PRIVATE_KEY=your_private_key_here

# RPC URLs
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545/
BSC_MAINNET_RPC=https://bsc-dataseed1.binance.org/
POLYGON_RPC=https://polygon-rpc.com
ETHEREUM_RPC=https://mainnet.infura.io/v3/your_infura_project_id

# API Keys for Contract Verification
BSCSCAN_API_KEY=your_bscscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key
ETHERSCAN_API_KEY=your_etherscan_api_key

# Infura Project ID (for Ethereum)
INFURA_PROJECT_ID=your_infura_project_id

# Gas Reporter
REPORT_GAS=true
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# Contract Addresses (filled after deployment)
PRANA_TOKEN_ADDRESS=
PRANA_EXCHANGE_ADDRESS=
PRANA_STAKING_ADDRESS=
USDT_TOKEN_ADDRESS=

# Deployment Configuration
DEPLOY_NETWORK=bscTestnet
VERIFY_CONTRACTS=true

# Zero Token Loss Configuration
ZTL_ENABLED=true
ZTL_CHECKPOINT_INTERVAL=100
ZTL_MAX_CHECKPOINTS=1000

# Security Configuration
MULTI_SIG_WALLET=
ADMIN_WALLET=
TREASURY_WALLET=
EMERGENCY_WALLET=

# Token Distribution (in percentage)
LIQUIDITY_ALLOCATION=40
STAKING_REWARDS_ALLOCATION=30
TEAM_ALLOCATION=15
MARKETING_ALLOCATION=10
RESERVE_ALLOCATION=5

# Exchange Configuration
INITIAL_PRANA_LIQUIDITY=1000000
INITIAL_USDT_LIQUIDITY=100000
EXCHANGE_FEE_BPS=0

# Staking Configuration
DAILY_ROI_RATE=1200
ROI_CAP_MULTIPLIER=200
MIN_STAKE_AMOUNT=10

# Referral Configuration
REFERRAL_LEVEL_1=400
REFERRAL_LEVEL_2=200
REFERRAL_LEVEL_3=100
REFERRAL_LEVEL_4=100
REFERRAL_LEVEL_5=100
REFERRAL_LEVEL_6=100
REFERRAL_LEVEL_7=100
REFERRAL_LEVEL_8=100